<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwPreferencesPage" id="others">
    <property name="name">others</property>
    <property name="title" translatable="yes">Icons</property>
    <property name="icon-name">overview-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Icon Visiblity and Location</property>
        <property name="description" translatable="yes">Show or hide certain icons.</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Favorite Apps Only</property>
            <property name="subtitle" translatable="yes">Show only icons of favorite apps. Hide icons of other running apps.</property>
            <property name="activatable-widget">favorites-only</property>
            <child>
              <object class="GtkSwitch" id="favorites-only">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Click Minimizes</property>
            <property name="subtitle" translatable="yes">Clicking the focused app's icon minimizes its windows. Off: nothing happens, as on macOS.</property>
            <property name="activatable-widget">click-minimizes</property>
            <child>
              <object class="GtkSwitch" id="click-minimizes">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Shift+Click</property>
            <property name="subtitle" translatable="yes">What Shift+clicking a running app's icon does.</property>
            <property name="activatable-widget">shift-click-action</property>
            <child>
              <object class="GtkDropDown" id="shift-click-action">
                <property name="valign">center</property>
                <property name="model">shift-click-action-model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Recent Apps</property>
            <property name="subtitle" translatable="yes">Show recently closed apps that are not pinned after the running apps, as macOS "Show suggested and recent apps in Dock".</property>
            <property name="activatable-widget">recent-apps-count</property>
            <child>
              <object class="GtkDropDown" id="recent-apps-count">
                <property name="valign">center</property>
                <property name="model">recent-apps-count-model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Open at Login in Menu</property>
            <property name="subtitle" translatable="yes">Add an "Open at Login" switch to the app icon menu (manages ~/.config/autostart).</property>
            <property name="activatable-widget">menu-open-at-login</property>
            <child>
              <object class="GtkSwitch" id="menu-open-at-login">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Click Shows App Windows</property>
            <property name="subtitle" translatable="yes">Clicking the focused app's icon when it has several windows shows only its windows (App Exposé).</property>
            <property name="activatable-widget">click-action-spread</property>
            <child>
              <object class="GtkSwitch" id="click-action-spread">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Drag Off to Remove</property>
            <property name="subtitle" translatable="yes">Drag a pinned icon away from the dock and drop it to unpin the app, as on macOS.</property>
            <property name="activatable-widget">drag-off-remove</property>
            <child>
              <object class="GtkSwitch" id="drag-off-remove">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Show All Windows Menu Item</property>
            <property name="subtitle" translatable="yes">Add &quot;Show All Windows&quot; (App Exposé) to the app icon menu.</property>
            <property name="activatable-widget">show-all-windows-item</property>
            <child>
              <object class="GtkSwitch" id="show-all-windows-item">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Keyboard Focus (Ctrl+Alt+Tab)</property>
            <property name="subtitle" translatable="yes">Ctrl+Alt+Tab lists the dock as "Dock": it is revealed and the focused icon is highlighted; arrows move, Enter opens.</property>
            <property name="activatable-widget">keyboard-focus</property>
            <child>
              <object class="GtkSwitch" id="keyboard-focus">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Isolate Workspaces</property>
            <property name="subtitle" translatable="yes">Only show running apps and indicators for windows on the current workspace.</property>
            <property name="activatable-widget">isolate-workspaces</property>
            <child>
              <object class="GtkSwitch" id="isolate-workspaces">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Dock Background Menu</property>
            <property name="subtitle" translatable="yes">Right-click the dock background or separator for Hiding, Magnification, Position and Dock Settings, as on macOS.</property>
            <property name="activatable-widget">background-menu</property>
            <child>
              <object class="GtkSwitch" id="background-menu">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Number Overlay on Super</property>
            <property name="subtitle" translatable="yes">While Super is held, show the Super+1..9 numbers on the first nine app icons.</property>
            <property name="activatable-widget">hotkeys-overlay</property>
            <child>
              <object class="GtkSwitch" id="hotkeys-overlay">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Spring-Loaded Icons</property>
            <property name="subtitle" translatable="yes">While dragging files, reveal a hidden dock; hold the files over an app icon to bring the app forward, as on macOS.</property>
            <property name="activatable-widget">spring-loading</property>
            <child>
              <object class="GtkSwitch" id="spring-loading">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Minimized Window Tiles</property>
            <property name="subtitle" translatable="yes">Show minimized windows as thumbnails before the Trash, as on macOS.</property>
            <property name="activatable-widget">minimized-window-tiles</property>
            <child>
              <object class="GtkSwitch" id="minimized-window-tiles">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Apps Icon</property>
            <property name="subtitle" translatable="yes">Show the Overview Apps icon.</property>
            <property name="activatable-widget">apps-icon</property>
            <child>
              <object class="GtkSwitch" id="apps-icon">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Apps Icon at Front</property>
            <property name="subtitle" translatable="yes">Position the Overview Apps icon at the front.</property>
            <property name="activatable-widget">apps-icon-front</property>
            <child>
              <object class="GtkSwitch" id="apps-icon-front">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Dynamic Icons</property>
        <property name="description" translatable="yes">Add icons that change according to system state.</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Trash</property>
            <property name="subtitle" translatable="yes">Add a dynamic Trash icon which changes with its state and which has access to Empty Trash action.</property>
            <property name="activatable-widget">trash-icon</property>
            <child>
              <object class="GtkSwitch" id="trash-icon">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Trash Style</property>
            <property name="subtitle" translatable="yes">Glass: a translucent bin showing what is inside — fill level, thumbnails and file types.</property>
            <property name="activatable-widget">trash-style</property>
            <child>
              <object class="GtkDropDown" id="trash-style">
                <property name="valign">center</property>
                <property name="model">trash-style-model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Mounted Devices</property>
            <property name="subtitle" translatable="yes">Show mounted device icons to quickly open or unmount volumes.</property>
            <property name="activatable-widget">mounted-icon</property>
            <child>
              <object class="GtkSwitch" id="mounted-icon">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Downloads</property>
            <property name="subtitle" translatable="yes">Show downloads folder to access recent download.</property>
            <property name="activatable-widget">downloads-icon</property>
            <child>
              <object class="GtkSwitch" id="downloads-icon">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Rotate labels</property>
            <property name="subtitle" translatable="yes">Rotate labels with downloaded file icons.</property>
            <property name="activatable-widget">downloads-icon-rotate-labels</property>
            <child>
              <object class="GtkSwitch" id="downloads-icon-rotate-labels">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">File Drops</property>
            <property name="subtitle" translatable="yes">Drop files from Files or any app onto the dock: Trash moves them to the trash, an app opens them, a folder stack or drive moves or copies them there, as on macOS. Runs a small helper process.</property>
            <property name="activatable-widget">file-drops</property>
            <child>
              <object class="GtkSwitch" id="file-drops">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="downloads-folder-row">
            <property name="visible">true</property>
            <property name="title" translatable="yes"/>
            <property name="subtitle" translatable="yes">Select downloads folder to monitor.(optional)</property>
            <property name="activatable-widget">downloads-folder</property>
            <child>
              <object class="GtkButton" id="downloads-folder">
                <property name="halign">start</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkBox">
                    <property name="margin-start">20</property>
                    <property name="margin-end">20</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Open</property>
                      </object>
                    </child>
                  </object>
                </child>
                <style>
                  <class name="circular"/>
                  <!-- <class name="destructive-action"/> -->
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Downloads View</property>
            <property name="subtitle" translatable="yes">Open the Downloads stack as a fan, a grid, a list, or automatically.</property>
            <property name="activatable-widget">downloads-stack-view</property>
            <child>
              <object class="GtkDropDown" id="downloads-stack-view">
                <property name="valign">center</property>
                <property name="model">downloads-stack-view-model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Downloads Sort By</property>
            <property name="subtitle" translatable="yes">Order of the files in the Downloads stack.</property>
            <property name="activatable-widget">downloads-stack-sort</property>
            <child>
              <object class="GtkDropDown" id="downloads-stack-sort">
                <property name="valign">center</property>
                <property name="model">downloads-stack-sort-model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Downloads Display As</property>
            <property name="subtitle" translatable="yes">Show the folder icon, or the top file like a stack.</property>
            <property name="activatable-widget">downloads-stack-display</property>
            <child>
              <object class="GtkDropDown" id="downloads-stack-display">
                <property name="valign">center</property>
                <property name="model">downloads-stack-display-model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwExpanderRow" id="folder-stacks-row">
            <property name="title" translatable="yes">Folder Stacks</property>
            <property name="subtitle" translatable="yes">More folders shown as stacks next to Downloads. Right-click a stack in the dock for its sort order, icon and view.</property>
            <child type="suffix">
              <object class="GtkButton" id="folder-stacks-add">
                <property name="valign">center</property>
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text" translatable="yes">Add folder</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="visible">false</property>
            <property name="title" translatable="yes">Recent Files</property>
            <property name="subtitle" translatable="yes">Show recently accessed files.</property>
            <property name="activatable-widget">documents-icon</property>
            <child>
              <object class="GtkSwitch" id="documents-icon">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Maximum Recent Items</property>
            <property name="subtitle" translatable="yes">Set maximum recent items to show.</property>
            <property name="activatable-widget">max-recent-items</property>
            <child>
              <object class="GtkDropDown" id="max-recent-items">
                <property name="valign">center</property>
                <property name="model">max-recent-items-model</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Custom Drawn Icons</property>
        <property name="description" translatable="yes">Override icon look with custom drawing and animation.</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Clock</property>
            <property name="subtitle" translatable="yes">Show an analog clock widget. Requires Clocks app (gnome-clocks) pinned to the dash.</property>
            <property name="activatable-widget">clock-icon</property>
            <child>
              <object class="GtkSwitch" id="clock-icon">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="clock-style-row">
            <property name="visible">true</property>
            <property name="title" translatable="yes">Clock Style</property>
            <property name="subtitle" translatable="yes">Set clock style.</property>
            <property name="activatable-widget">clock-style</property>
            <child>
              <object class="GtkDropDown" id="clock-style">
                <property name="valign">center</property>
                <property name="model">clock-style-model</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Calendar</property>
            <property name="subtitle" translatable="yes">Show an calendar widget. Requires Calendar app (gnome-calendar) pinned to the dash.</property>
            <property name="activatable-widget">calendar-icon</property>
            <child>
              <object class="GtkSwitch" id="calendar-icon">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="calendar-style-row">
            <property name="visible">false</property>
            <property name="title" translatable="yes">Calendar Style</property>
            <property name="subtitle" translatable="yes">Set calendar style.</property>
            <property name="activatable-widget">calendar-style</property>
            <child>
              <object class="GtkDropDown" id="calendar-style">
                <property name="valign">center</property>
                <property name="model">calendar-style-model</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkStringList" id="trash-style-model">
    <items>
      <item>Theme Icon</item>
      <item>Glass</item>
    </items>
  </object>
  <object class="GtkStringList" id="clock-style-model">
    <items>
      <item>Round 1</item>
      <item>Round 2</item>
      <item>Round 3</item>
      <item>Round 4</item>
      <item>Framed 1</item>
      <item>Framed 2</item>
      <item>Framed 3</item>
      <item>Framed 4</item>
    </items>
  </object>
  <object class="GtkStringList" id="calendar-style-model">
    <items>
      <item>Overlay 1</item>
      <item>Overlay 2</item>
      <item>Framed 1</item>
      <item>Framed 2</item>
    </items>
  </object>
  <object class="GtkStringList" id="max-recent-items-model">
    <items>
      <item>5</item>
      <item>8</item>
      <item>10</item>
      <item>12</item>
      <item>15</item>
      <item>20</item>
      <item>25</item>
    </items>
  </object>
  <object class="GtkStringList" id="shift-click-action-model">
    <items>
      <item translatable="yes">Maximize / Restore</item>
      <item translatable="yes">New Window</item>
    </items>
  </object>
  <object class="GtkStringList" id="recent-apps-count-model">
    <items>
      <item translatable="yes">Off</item>
      <item>1</item>
      <item>2</item>
      <item>3</item>
      <item>4</item>
      <item>5</item>
    </items>
  </object>
  <object class="GtkStringList" id="downloads-stack-view-model">
    <items>
      <item translatable="yes">Fan</item>
      <item translatable="yes">Grid</item>
      <item translatable="yes">List</item>
      <item translatable="yes">Automatic</item>
    </items>
  </object>
  <object class="GtkStringList" id="downloads-stack-sort-model">
    <items>
      <item translatable="yes">Date Modified</item>
      <item translatable="yes">Name</item>
      <item translatable="yes">Date Added</item>
      <item translatable="yes">Date Created</item>
      <item translatable="yes">Kind</item>
    </items>
  </object>
  <object class="GtkStringList" id="downloads-stack-display-model">
    <items>
      <item translatable="yes">Folder</item>
      <item translatable="yes">Stack</item>
    </items>
  </object>
</interface>
